## Makefile.Apple -- meta makefile for DiffMerge on Apple.
## This does a full build of wxWidgets and then DiffMerge.
## This is a wrapper for the lazy and/or the build server.
##################################################################

OS_NAME:=Apple

## BUILD -- Where do you want the binaries we build.
BUILD:=$(shell dirname ${PWD})/builds
$(info $(OS_NAME) builds will be rooted at: $(BUILD)/)

## MODE  -- either "Debug" or "Release"
MODE:=Release
####MODE:=Debug

include version.inc

## set ARCH, ARCH_PACKAGE
include src/Config/Arch.$(OS_NAME).inc

WXWIDGETS_VERSION:=3.2.6

$(info Building $(BUILD_MAJOR).$(BUILD_MINOR).$(BUILD_REVISION).$(BUILD_BUILDNUM) : $(BUILD_BUILDLABEL) : $(BUILD_CSID))

WXOBJ:=$(shell $(MAKE) -C thirdparty -f Makefile.$(OS_NAME) BUILD=$(BUILD) OS_NAME=$(OS_NAME) MODE=$(MODE) ARCH=$(ARCH) ARCH_PACKAGE=$(ARCH_PACKAGE) VERSION=$(WXWIDGETS_VERSION) _wxroot)
$(info Looking for WX objs in $(WXOBJ)...)
WX_MONO_LIB_PATTERN:=$(WXOBJ)/lib/libwx_osx_cocoau-*.a

## TIMEOUT_SEC -- optional timeout for long build steps (seconds).
TIMEOUT_SEC?=3600
TIMEOUT_IMPL:=$(shell if command -v gtimeout >/dev/null 2>&1; then echo gtimeout; \
	elif command -v timeout >/dev/null 2>&1; then echo timeout; \
	elif command -v perl >/dev/null 2>&1; then echo perl; \
	fi)
ifeq ($(strip $(TIMEOUT_IMPL)),perl)
TIMEOUT_PREFIX:=$(TIMEOUT_IMPL) -e 'alarm shift; exec @ARGV' $(TIMEOUT_SEC)
else ifeq ($(strip $(TIMEOUT_IMPL)),)
TIMEOUT_PREFIX:=
else
TIMEOUT_PREFIX:=$(TIMEOUT_IMPL) $(TIMEOUT_SEC)
endif

##################################################################

all:	maybe_build_thirdparty build_diffmerge report_outputs

##################################################################
## Cheap test to see if we need to build wxWidgets.

maybe_build_thirdparty:
	@if [ ! -d $(WXOBJ) ] || [ -z "$(wildcard $(WX_MONO_LIB_PATTERN))" ] ; then \
		$(TIMEOUT_PREFIX) $(MAKE) -C thirdparty -f Makefile.$(OS_NAME) BUILD=$(BUILD) OS_NAME=$(OS_NAME) MODE=$(MODE) ARCH=$(ARCH) ARCH_PACKAGE=$(ARCH_PACKAGE) VERSION=$(WXWIDGETS_VERSION) _all; \
	else \
		echo Skipping compile of wxWidgets....; \
	fi

##################################################################

build_diffmerge:
	$(TIMEOUT_PREFIX) $(MAKE) -C src -f Makefile.Unix BUILD=$(BUILD) MODE=$(MODE) OS_NAME=$(OS_NAME) ARCH=$(ARCH) ARCH_PACKAGE=$(ARCH_PACKAGE) BUILD_MAJOR=$(BUILD_MAJOR) BUILD_MINOR=$(BUILD_MINOR) BUILD_REVISION=$(BUILD_REVISION) BUILD_BUILDNUM=$(BUILD_BUILDNUM) BUILD_BUILDLABEL=$(BUILD_BUILDLABEL) BUILD_CSID=$(BUILD_CSID)

##################################################################

report_outputs:
	@$(TIMEOUT_PREFIX) $(MAKE) -C src -f Makefile.Unix --no-print-directory BUILD=$(BUILD) MODE=$(MODE) OS_NAME=$(OS_NAME) ARCH=$(ARCH) ARCH_PACKAGE=$(ARCH_PACKAGE) BUILD_MAJOR=$(BUILD_MAJOR) BUILD_MINOR=$(BUILD_MINOR) BUILD_REVISION=$(BUILD_REVISION) BUILD_BUILDNUM=$(BUILD_BUILDNUM) BUILD_BUILDLABEL=$(BUILD_BUILDLABEL) BUILD_CSID=$(BUILD_CSID) report_outputs
